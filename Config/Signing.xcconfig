// Default signing: ad-hoc ("-"), so anyone can build without an Apple account.
//
// Ad-hoc builds get a new signature on every build, which makes macOS forget
// the Accessibility permission. To keep it, create Config/Signing.local.xcconfig
// (git-ignored) with your own identity, e.g.:
//
//   CODE_SIGN_IDENTITY = Developer ID Application
//   DEVELOPMENT_TEAM = ABCDE12345
//
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
