[
  {"name": "running from PreToolUse", "args": ["running"], "stdin": {"session_id": "s1", "cwd": "/home/me/app", "transcript_path": "/home/me/.claude/projects/x/s1.jsonl", "hook_event_name": "PreToolUse"}, "expect": {"state": "running", "cwd": "/home/me/app", "transcript_path": "/home/me/.claude/projects/x/s1.jsonl", "event": "PreToolUse", "kind": null, "request": null}},
  {"name": "done from Stop", "args": ["done"], "stdin": {"session_id": "s1", "hook_event_name": "Stop"}, "expect": {"state": "done", "kind": null}},
  {"name": "idle", "args": ["idle"], "stdin": {"session_id": "s1"}, "expect": {"state": "idle"}},
  {"name": "PermissionRequest names the tool", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "PermissionRequest", "tool_name": "Bash"}, "expect": {"state": "waiting", "kind": "approval", "request": "Bash"}},
  {"name": "long tool name is cut to 40", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "PermissionRequest", "tool_name": "mcp__server__aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {"state": "waiting", "kind": "approval", "request": "mcp__server__aaaaaaaaaaaaaaaaaaaaaaaaaaa"}},
  {"name": "permission_prompt parses the message", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "notification_type": "permission_prompt", "message": "Claude needs your permission to use Write."}, "expect": {"state": "waiting", "kind": "approval", "request": "Write"}},
  {"name": "elicitation is a question", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "notification_type": "elicitation_dialog", "message": "Pick one"}, "expect": {"state": "waiting", "kind": "question", "request": null}},
  {"name": "agent_needs_input is a question", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "notification_type": "agent_needs_input"}, "expect": {"state": "waiting", "kind": "question"}},
  {"name": "unrelated notification is ignored", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "notification_type": "idle_prompt", "message": "Claude is waiting for your input"}, "expect": "none"},
  {"name": "old Claude Code: permission text fallback", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "message": "Claude needs your PERMISSION to use Bash"}, "expect": {"state": "waiting", "kind": "approval", "request": "Bash"}},
  {"name": "old Claude Code: other text ignored", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "message": "Claude is waiting for your input"}, "expect": "none"},
  {"name": "waiting with no message ignored", "args": ["waiting"], "stdin": {"session_id": "s1"}, "expect": "none"},
  {"name": "notification_type that isn't text is ignored", "args": ["waiting"], "stdin": {"session_id": "s1", "hook_event_name": "Notification", "notification_type": 7, "message": "Claude needs your permission to use Bash"}, "expect": "none"},
  {"name": "non-ASCII session id ignored", "args": ["running"], "stdin": {"session_id": "séssion"}, "expect": "none"},
  {"name": "invalid JSON ignored", "args": ["waiting"], "stdin_raw": "not json", "expect": "none"},
  {"name": "invalid JSON ignored for running too", "args": ["running"], "stdin_raw": "{oops", "expect": "none"},
  {"name": "JSON array ignored", "args": ["running"], "stdin_raw": "[1,2]", "expect": "none"},
  {"name": "unsafe session id ignored", "args": ["running"], "stdin": {"session_id": "../../etc/passwd"}, "expect": "none"},
  {"name": "missing session id ignored", "args": ["running"], "stdin": {"cwd": "/x"}, "expect": "none"},
  {"name": "very long cwd dropped", "args": ["running"], "stdin": {"session_id": "s1", "cwd": "LONG1100"}, "expect": {"state": "running", "cwd": null}},
  {"name": "end deletes the file", "args": ["end"], "stdin": {"session_id": "s1"}, "existing": {"v": 1, "session_id": "s1", "state": "running", "ts": 1}, "expect": "deleted"},
  {"name": "end with no file is fine", "args": ["end"], "stdin": {"session_id": "s1"}, "expect": "none"},
  {"name": "newer existing event wins", "args": ["running"], "stdin": {"session_id": "s1"}, "existing": {"v": 1, "session_id": "s1", "state": "waiting", "kind": "approval", "ts": 99999999999999}, "expect": {"state": "waiting", "ts": 99999999999999}},
  {"name": "older existing event is replaced", "args": ["running"], "stdin": {"session_id": "s1"}, "existing": {"v": 1, "session_id": "s1", "state": "waiting", "kind": "approval", "ts": 1}, "expect": {"state": "running", "kind": null}}
]
